# Core API runtime
RITRON_API_ENVIRONMENT=development
RITRON_API_HOST=127.0.0.1
RITRON_API_PORT=8000
RITRON_API_LOG_LEVEL=INFO
RITRON_API_CORS_ORIGINS=http://localhost:1420

# Future configuration boundaries. Leave blank unless the corresponding
# milestone has introduced the integration. Never put real credentials here.
RITRON_DATABASE_URL=
RITRON_REDIS_URL=
RITRON_TELEMETRY_ENDPOINT=
RITRON_MODEL_PROVIDER=
RITRON_MODEL_API_KEY=
RITRON_FEATURE_FLAGS=
